<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_dark">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical"><ImageView android:id="@+id/widget_badge" android:layout_width="22dp" android:layout_height="22dp" android:scaleType="fitCenter" android:src="@drawable/notification_ball" android:contentDescription="主队队徽"/><TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#D6E5E9" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_marginStart="8dp" android:text="看球 · 主队比赛"/><TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#D6E5E9" android:maxLines="1" android:ellipsize="end" android:text="↻" android:gravity="center" android:minWidth="44dp" android:minHeight="32dp" android:contentDescription="刷新小组件"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><ImageView android:id="@+id/widget_home_logo" android:layout_width="28dp" android:layout_height="28dp" android:scaleType="fitCenter" android:contentDescription="主队队徽"/><TextView android:id="@+id/widget_home" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#D6E5E9" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><TextView android:id="@+id/widget_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="#D6E5E9" android:maxLines="1" android:ellipsize="end" android:text="VS" android:textStyle="bold"/><TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#D6E5E9" android:maxLines="1" android:ellipsize="end" android:text="点击查看比赛"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"><ImageView android:id="@+id/widget_away_logo" android:layout_width="28dp" android:layout_height="28dp" android:scaleType="fitCenter" android:contentDescription="客队队徽"/><TextView android:id="@+id/widget_away" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#D6E5E9" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp"/></LinearLayout>
 </LinearLayout>
